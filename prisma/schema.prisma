generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  logEntries    LogEntry[]
  presence      Presence?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Shared household grocery state. One row per distinct food item.
/// "Available food" and "shopping list" are the same table split by `status`,
/// which is what makes scanning a receipt remove items from the shopping list
/// for free — it is the same upsert that adds them.
model PantryItem {
  id        String   @id @default(cuid())
  name      String   @unique // normalized dedupe key, e.g. "banana"
  label     String // display name, e.g. "Bananas"
  /// JSON array of other everyday names for this item, e.g. ["creamer"] on
  /// "half and half". Covers synonyms that share no words, which word-subset
  /// matching alone cannot reach. Seeded by the model, then learned over time.
  aliases   String   @default("[]")
  quantity  String? // "2.4 lb", "3" — display only, never used in arithmetic
  status    String // "available" | "needed"
  source    String // "receipt" | "message" | "manual"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model LogEntry {
  id          String   @id @default(cuid())
  rawInput    String
  summary     String
  category    String
  tags        String   // JSON array
  actionItems String   // JSON array
  metadata    String   @default("{}") // AI-extracted structured data
  mood        String?
  inputMethod String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A recipe the household kept. Shared, not per-user, for the same reason the
/// pantry is: it is generated from shared stock and cooked by whoever is in.
/// `title` is unique so saving the same suggestion twice is an upsert rather
/// than a duplicate row — the model reliably repeats a dish under one name.
model SavedRecipe {
  id          String   @id @default(cuid())
  title       String   @unique
  description String
  minutes     Int
  servings    Int
  ingredients String // JSON array of { item, amount, have }
  steps       String // JSON array of strings
  favorite    Boolean  @default(false)
  plans       MealPlan[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([favorite])
}

/// One recipe pinned to a day part. `date` is a plain "YYYY-MM-DD" local date
/// rather than a DateTime: the plan is "what are we eating Saturday", and a
/// timestamp would shift that across a timezone or a DST boundary.
/// Unique on (date, meal) — a day part holds exactly one dish, so choosing
/// again replaces rather than stacks.
model MealPlan {
  id        String      @id @default(cuid())
  date      String
  meal      String // "breakfast" | "lunch" | "dinner"
  recipeId  String
  recipe    SavedRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([date, meal])
  @@index([date])
}

/// Household-wide key/value scratch. Currently holds exactly one key,
/// "recipePreferences" — the free text the cook wants folded into every
/// suggestion prompt. Shared, like the pantry and the recipes, because the
/// people eating are the same people.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Who is currently in the app, and what they are up to.
/// One row per user, overwritten by their heartbeat, so the table stays the
/// size of the household rather than growing with every visit. There is no
/// cleanup job because nothing is ever stale-deleted: a row older than the
/// online window simply stops being counted.
model Presence {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Route they are on, e.g. "/pantry". Used to describe them when there is
  /// no more specific activity to report.
  path      String
  /// What they are doing or just did, e.g. "scanning a receipt" or "added
  /// peanut butter". Null most of the time; `path` covers the rest.
  activity  String?
  /// When `activity` was set. Separate from `updatedAt`, which every
  /// heartbeat bumps and so can never say how old the activity itself is.
  /// Past ACTIVITY_TTL_MS the activity stops being shown, which is what
  /// stops "added peanut butter" hanging under a face all evening.
  activityAt DateTime?
  updatedAt DateTime @updatedAt
}
