generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  logEntries    LogEntry[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Shared household grocery state. One row per distinct food item.
/// "Available food" and "shopping list" are the same table split by `status`,
/// which is what makes scanning a receipt remove items from the shopping list
/// for free — it is the same upsert that adds them.
model PantryItem {
  id        String   @id @default(cuid())
  name      String   @unique // normalized dedupe key, e.g. "banana"
  label     String // display name, e.g. "Bananas"
  /// JSON array of other everyday names for this item, e.g. ["creamer"] on
  /// "half and half". Covers synonyms that share no words, which word-subset
  /// matching alone cannot reach. Seeded by the model, then learned over time.
  aliases   String   @default("[]")
  quantity  String? // "2.4 lb", "3" — display only, never used in arithmetic
  status    String // "available" | "needed"
  source    String // "receipt" | "message" | "manual"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model LogEntry {
  id          String   @id @default(cuid())
  rawInput    String
  summary     String
  category    String
  tags        String   // JSON array
  actionItems String   // JSON array
  metadata    String   @default("{}") // AI-extracted structured data
  mood        String?
  inputMethod String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A recipe the household kept. Shared, not per-user, for the same reason the
/// pantry is: it is generated from shared stock and cooked by whoever is in.
/// `title` is unique so saving the same suggestion twice is an upsert rather
/// than a duplicate row — the model reliably repeats a dish under one name.
model SavedRecipe {
  id          String   @id @default(cuid())
  title       String   @unique
  description String
  minutes     Int
  servings    Int
  ingredients String // JSON array of { item, amount, have }
  steps       String // JSON array of strings
  favorite    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([favorite])
}
